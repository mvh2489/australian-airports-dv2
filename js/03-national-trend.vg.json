{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#516b79",
      "titleColor": "#193c52",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 12,
      "gridColor": "#e3ecef",
      "domain": false,
      "tickColor": "#e3ecef",
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#516b79",
      "titleColor": "#193c52",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 8,
      "titleLimit": 450,
      "labelLimit": 200,
      "padding": 10,
      "orient": "bottom"
    },
    "title": {
      "anchor": "start",
      "fontSize": 15,
      "color": "#193c52",
      "fontWeight": 600
    },
    "text": {
      "font": "Arial",
      "color": "#193c52"
    }
  },
  "data": {
    "url": "data/national.json"
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": 2019.6,
            "end": 2022.2
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#d8dfe0",
        "opacity": 0.4
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015,
              2025
            ],
            "zero": false
          }
        },
        "x2": {
          "field": "end"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year <= 2025"
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 35
        },
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Financial year ending June",
          "axis": {
            "format": "d",
            "tickMinStep": 1,
            "tickCount": 6
          },
          "scale": {
            "domain": [
              2015,
              2025
            ],
            "zero": false
          }
        },
        "y": {
          "field": "passengers",
          "type": "quantitative",
          "title": "Passenger trips (not unique people)",
          "axis": {
            "format": ".2s",
            "tickCount": 5
          },
          "scale": {
            "domain": [
              0,
              65000000
            ]
          }
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Domestic",
              "International"
            ],
            "range": [
              "#2678a8",
              "#c4542f"
            ]
          }
        },
        "tooltip": [
          {
            "field": "type",
            "title": "Service"
          },
          {
            "field": "fy",
            "title": "Financial year"
          },
          {
            "field": "passengers",
            "title": "Passenger trips",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2020.8,
            "passengers": 64000000,
            "text": "COVID-19 disruption"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "color": "#516b79"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015,
              2025
            ],
            "zero": false
          }
        },
        "y": {
          "field": "passengers",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ]
}
